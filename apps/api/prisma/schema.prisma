// Importų ir importuotų prekių modeliai.
// Fizinės lentelės ir stulpeliai – snake_case; Prisma modeliai – PascalCase.
// Migracijos ir importo logika nėra šios užduoties dalis.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Import {
  id           String   @id @default(uuid()) @db.Uuid
  importNumber String   @unique @map("import_number")
  name         String
  fileName     String   @map("filename")
  importedAt   DateTime @map("imported_at")
  rowCount     Int      @map("row_count")
  fieldMapping Json     @map("field_mapping") @db.JsonB
  goods        Good[]

  @@map("imports")
}

model Good {
  id                String   @id @default(uuid()) @db.Uuid
  importId          String   @map("import_id") @db.Uuid
  sourceCode        String   @map("source_code")
  originalBarcode   String?  @map("original_barcode")
  quantity          Int
  sourceRetailPrice Decimal? @map("source_retail_price") @db.Decimal(12, 2)
  imageUrl          String?  @map("image_url")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  code           String?
  barcode        String?  @unique
  name           String
  purchasePrice  Decimal? @map("purchase_price") @db.Decimal(12, 2)
  retailPrice    Decimal? @map("retail_price") @db.Decimal(12, 2)
  promotionPrice Decimal? @map("promotion_price") @db.Decimal(12, 2)
  sku            String?
  productGroup   String?  @map("product_group")
  brand          String?
  collection     String?
  customsCode    String?  @map("customs_code")
  grossWeight    Decimal? @map("gross_weight") @db.Decimal(12, 3)
  netWeight      Decimal? @map("net_weight") @db.Decimal(12, 3)

  importRecord Import @relation(fields: [importId], references: [id], onDelete: Restrict)

  @@unique([importId, sourceCode])
  @@index([importId])
  @@index([originalBarcode])
  @@map("goods")
}
