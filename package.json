{
  "name": "goods-import",
  "version": "0.1.0",
  "private": true,
  "description": "Goods Import – Electron + React + TypeScript klientas ir TypeScript API su Prisma",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "dev:desktop": "npm run dev --workspace @goods-import/desktop",
    "dev:api": "npm run dev --workspace @goods-import/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace @goods-import/api",
    "prisma:validate": "npm run prisma:validate --workspace @goods-import/api"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "electron@44.11.5": true
  }
}
